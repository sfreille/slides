* text=auto

# Binary formats — skip CRLF conversion and diffing
*.html binary
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.svg  binary
*.gif  binary
*.ico  binary

# Text files — LF in repo, CRLF on checkout on Windows
*.qmd  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.scss text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.R    text eol=lf
*.md   text eol=lf
*.bib  text eol=lf
*.tex  text eol=lf
